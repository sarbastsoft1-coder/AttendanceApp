# Application Settings
PROJECT_NAME=Recognition Based Automated Attendance System

# Security - CHANGE THIS IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-this-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_LOGIN_KEY=admin-login-2026

# Database - PostgreSQL
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/attendance_db

# Face Recognition Settings
FACE_RECOGNITION_TOLERANCE=0.6
