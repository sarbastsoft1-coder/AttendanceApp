# Copy these values into Coolify environment variables or a local `.env` file.

POSTGRES_DB=attendance_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

BACKEND_PORT=8000
PROJECT_NAME=Recognition Based Automated Attendance System
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FACE_RECOGNITION_TOLERANCE=0.6
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.com
